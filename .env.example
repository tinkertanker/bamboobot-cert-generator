# BambooBot environment configuration
#
# Local development: copy this file to .env. `next dev` reads it, and so does
# Wrangler (`npm run preview`) when there is no .dev.vars file.
#
# Production (Cloudflare Workers): set secrets with `wrangler secret put NAME`
# (or in the dashboard under Workers > bamboobot > Settings > Variables).
# Plain settings can go in "vars" in wrangler.jsonc. NEXT_PUBLIC_* values are
# read when the Worker is built, so they must be in the build environment.
#
# Bindings (D1 database, R2 bucket, Durable Object, rate limits, cron) are not
# environment variables; they are declared in wrangler.jsonc.

# ========================================
# APPLICATION SETTINGS
# ========================================

# Disable Next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# Server-only runtime auth gate. Production defaults to enabled when omitted.
# Setting false removes the global login wall, including from APIs. Use it only
# in a trusted local environment; only endpoints with their own checks remain protected.
REQUIRE_AUTH=true

# Enable server persistence for projects (client-visible flag).
# Read at build time: after changing it, rebuild and redeploy (npm run deploy).
NEXT_PUBLIC_PROJECT_SERVER_PERSISTENCE=false

# Rate limiting. In production the limits come from the "ratelimits" bindings in
# wrangler.jsonc. These values apply only where those bindings are missing
# (next dev, tests).
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_API_PER_MIN=120
# RATE_LIMIT_UPLOAD_PER_MIN=6
# RATE_LIMIT_GENERATE_PER_MIN=10
# RATE_LIMIT_DOWNLOAD_PER_MIN=30
# RATE_LIMIT_ZIP_PER_MIN=5
# RATE_LIMIT_EMAIL_PER_MIN=60
# RATE_LIMIT_MAX_BUCKETS=10000
# Outside Cloudflare only: trust X-Real-IP / X-Forwarded-For from a proxy.
# TRUST_PROXY_HEADERS=false

# ========================================
# FILES (Cloudflare R2)
# ========================================
# Files are stored in the R2 bucket bound as FILES in wrangler.jsonc.
# HMAC secret for expiring download links (falls back to NEXTAUTH_SECRET)
# FILE_URL_SIGNING_SECRET=replace-with-a-long-random-secret

# Server-side PDF limits (downloads, ZIPs, and email attachments)
# MAX_PDF_SOURCE_SIZE_BYTES=26214400  # 25MB per PDF
# MAX_BULK_EMAIL_ATTACHMENT_BYTES=104857600  # 100MB per bulk request (250MB hard max)
# MAX_ZIP_DURATION_MS=60000  # Whole ZIP operation (120 seconds hard max)

# Maximum upload file size in bytes (default: 10485760 = 10MB)
# MAX_UPLOAD_SIZE=20971520  # 20MB

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
# Configure either Resend or Amazon SES (or both)
# The app auto-detects which provider to use based on available credentials

# --- Option 1: Resend (Simpler) ---
# Free tier: 100 emails/day, 3000 emails/month
# Sign up at https://resend.com
# RESEND_API_KEY=re_123456789_XXXXXXXXXXXXXXXXXXXXXXXX

# --- Option 2: Amazon SES (Higher volume) ---
# Configure in AWS Console
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_SES_REGION=us-east-1
# AWS_SES_RATE_LIMIT=50  # Optional: emails per second

# --- Common Email Settings ---
# EMAIL_FROM=certificates@yourdomain.com  # Must be verified with your provider
# EMAIL_PROVIDER_SEND_TIMEOUT_MS=30000
# MAX_PENDING_EMAIL_PROVIDER_SENDS=8
# Bulk queues are held per user in a Durable Object; these caps are per user.
# MAX_ACTIVE_EMAIL_QUEUES_PER_USER=5
# MAX_CONCURRENT_EMAIL_INGESTIONS_PER_USER=2
# MAX_PAUSED_EMAIL_QUEUES_PER_USER=2
# MAX_RETAINED_EMAIL_ATTACHMENT_BYTES_PER_USER=262144000

# ========================================
# SECURITY & MAINTENANCE
# ========================================

# Protects /api/cleanup-r2. The daily cron trigger (wrangler.jsonc) sends it,
# and skips the cleanup when it is not set.
# CLEANUP_SECRET_KEY=your-secret-cleanup-key-here

# ========================================
# AUTH + DATABASE
# ========================================
# NextAuth (Auth.js) Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Also derives the key the email queue Durable Object uses to call back into
# the Worker, so it must be set in production.
NEXTAUTH_SECRET= # generate: `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000

# The database is Cloudflare D1 (binding DB in wrangler.jsonc). This URL is
# only for the Prisma CLI, e.g. `prisma migrate diff`; the app does not use it.
DATABASE_URL="file:./dev.db"

# ========================================
# USER TIER CONFIGURATION
# ========================================
# Auto-elevate users to admin/super_admin based on email
# These settings only apply when authentication is enabled (REQUIRE_AUTH=true)
# Removing an email or domain revokes that admin tier (back to free) on the user's
# next request. Admin tiers granted by a super admin in /admin/users are kept.

# Super Admin emails (comma-separated, highest privileges)
# Users with these exact email addresses get super_admin tier
# Example: admin@yourcompany.com,founder@yourteam.org
SUPER_ADMIN_EMAILS=

# Admin domains (comma-separated, all users from these domains become admins)
# Any user with an email from these domains gets admin tier
# Example: yourcompany.com,yourteam.org,internal.example
ADMIN_DOMAINS=

# Legacy single value support (deprecated - use multi-value versions above)
# These will be used as fallback if the multi-value versions are not set
# SUPER_ADMIN_EMAIL=admin@yourcompany.com
# ADMIN_DOMAIN=yourcompany.com
