{
  "name": "bamboobot-certificate-generator",
  "version": "1.0.0",
  "description": "Professional certificate generator with drag-and-drop text positioning, advanced formatting, and bulk PDF generation",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/migrate-private-storage.js",
    "dev": "npm run build:worker && npm run build:agent && next dev --webpack",
    "build": "prisma generate && npm run build:worker && npm run build:agent && next build --webpack",
    "build:cloudflare": "npm run check:cloudflare && BAMBOOBOT_RUNTIME=workers NEXT_PUBLIC_PROJECT_SERVER_PERSISTENCE=true opennextjs-cloudflare build",
    "check:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "preview:cloudflare": "wrangler dev --local",
    "build:worker": "webpack --config webpack.worker.config.js",
    "build:agent": "webpack --config webpack.agent.config.js",
    "agent:worker": "node build/agent-worker.js",
    "prestart": "node scripts/migrate-private-storage.js",
    "start": "next start",
    "migrate:storage": "node scripts/migrate-private-storage.js",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint pages components lib --ext .js,.jsx,.ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify": "node scripts/verify-frontend.js",
    "test:build": "jest __tests__/build.test.ts",
    "cleanup": "node scripts/cleanup.js",
    "cleanup:old": "node scripts/cleanup-old-files.js",
    "cleanup:old:dry": "node scripts/cleanup-old-files.js --dry-run",
    "test:r2-cleanup": "tsx scripts/test-r2-cleanup.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install",
    "prisma": "prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/client-ses": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@opennextjs/cloudflare": "1.20.12",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.1.0",
    "archiver": "^7.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.1",
    "driver.js": "^1.3.6",
    "file-saver": "^2.0.5",
    "formidable": "^3.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.441.0",
    "mime-types": "^3.0.1",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-table": "^7.8.0",
    "react-window": "^1.8.11",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^6.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/formidable": "^3.4.5",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-table": "^7.7.20",
    "@types/react-window": "^1.8.8",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.5.23",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "node-mocks-http": "^1.17.2",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "ts-loader": "^9.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "wrangler": "4.151.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.26"
    }
  }
}
